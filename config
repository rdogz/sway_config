# ~/.config/sway/config
# Translated from Hyprlua config

set $mod Mod4

# --- Variables ---
set $browser firefox
set $terminal foot
set $file_manager thunar
set $screenshot exec $HOME/.config/scripts/screenshot.sh
set $audio pavucontrol

# --- Affected by variables ---
# NOTE: your original bound SUPER+Q to launch the terminal (not close a window,
# which is the usual convention). Kept as-is below.
bindsym $mod+q exec $terminal
bindsym $mod+n exec $browser
bindsym $mod+c exec chromium
bindsym $mod+e exec $file_manager
bindsym $mod+s $screenshot
bindsym $mod+a exec $audio

# --- Static ---
bindsym $mod+f fullscreen toggle
bindsym Mod1+q kill

# --- Workspaces ---
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym Mod1+1 move container to workspace number 1
bindsym Mod1+2 move container to workspace number 2
bindsym Mod1+3 move container to workspace number 3
bindsym Mod1+4 move container to workspace number 4
bindsym Mod1+5 move container to workspace number 5
bindsym Mod1+6 move container to workspace number 6
bindsym Mod1+7 move container to workspace number 7
bindsym Mod1+8 move container to workspace number 8
bindsym Mod1+9 move container to workspace number 9
bindsym Mod1+0 move container to workspace number 10

# --- Switch focus ---
# Sway has no built-in "cycle to next window" bind like Hyprland's cycle_next.
# `focus next` cycles within the current container/output; wired here as the
# closest equivalent. A true global window-cycler needs a script or a
# tool like swayr/sworkstyle.
bindsym $mod+Tab focus next

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

# --- Drag ---
# Sway's floating_modifier only takes ONE modifier (no ALT+LMB drag-threshold
# equivalent) and it moves floating windows by holding mod + left-click,
# dragging anywhere on the window (not just the titlebar). There's no
# built-in "drag after 10px" behavior distinct from a normal move-drag.
floating_modifier $mod normal
