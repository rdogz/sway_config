" tab number
set tabstop=4       
set shiftwidth=4    

" autocomplete
inoremap " ""<left>
inoremap ( ()<left>
inoremap [ []<left>
inoremap { {}<left>


" enable syntax highlighting
syntax on

" enable line numbers
set number
set relativenumber

" Map <Space> to start forward search (like /)
nnoremap <Space> /
